{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/patch-bi-modules.mjs",
    "prestart": "node scripts/patch-bi-modules.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/patch-bi-modules.mjs",
    "build": "ng build",
    "test": "vitest run",
    "test:bi-package-patch": "node --test scripts/patch-bi-modules.node-test.mjs",
    "test:real-grid": "ng run frontend:test-real-grid",
    "watch": "ng build --watch --configuration development"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.2.2",
    "@angular/cdk": "20.2.2",
    "@angular/common": "20.2.2",
    "@angular/compiler": "20.2.2",
    "@angular/core": "20.2.2",
    "@angular/forms": "20.2.2",
    "@angular/localize": "20.2.2",
    "@angular/material": "20.2.2",
    "@angular/material-moment-adapter": "20.2.2",
    "@angular/platform-browser": "20.2.2",
    "@angular/router": "20.2.2",
    "@ngx-translate/core": "^15.0.0",
    "@progress/kendo-angular-buttons": "20.1.2",
    "@progress/kendo-angular-common": "20.1.2",
    "@progress/kendo-angular-conversational-ui": "20.1.2",
    "@progress/kendo-angular-dateinputs": "20.1.2",
    "@progress/kendo-angular-dialog": "20.1.2",
    "@progress/kendo-angular-dropdowns": "20.1.2",
    "@progress/kendo-angular-excel-export": "20.1.2",
    "@progress/kendo-angular-filter": "20.1.2",
    "@progress/kendo-angular-grid": "20.1.2",
    "@progress/kendo-angular-icons": "20.1.2",
    "@progress/kendo-angular-indicators": "20.1.2",
    "@progress/kendo-angular-inputs": "20.1.2",
    "@progress/kendo-angular-intl": "20.1.2",
    "@progress/kendo-angular-l10n": "20.1.2",
    "@progress/kendo-angular-label": "20.1.2",
    "@progress/kendo-angular-layout": "20.1.2",
    "@progress/kendo-angular-listview": "20.1.2",
    "@progress/kendo-angular-menu": "20.1.2",
    "@progress/kendo-angular-navigation": "20.1.2",
    "@progress/kendo-angular-pager": "20.1.2",
    "@progress/kendo-angular-pdf-export": "20.1.2",
    "@progress/kendo-angular-popup": "20.1.2",
    "@progress/kendo-angular-progressbar": "20.1.2",
    "@progress/kendo-angular-toolbar": "20.1.2",
    "@progress/kendo-angular-tooltip": "20.1.2",
    "@progress/kendo-angular-treeview": "20.1.2",
    "@progress/kendo-angular-upload": "20.1.2",
    "@progress/kendo-angular-utils": "20.1.2",
    "@progress/kendo-drawing": "1.22.1",
    "@salesbuzz/public-sdk": "file:../../Packages/npm/salesbuzz-public-sdk-1.0.2.tgz",
    "bi-interfaces": "file:../../Packages/npm/bi-interfaces-0.0.1.tgz",
    "bi-modules": "file:../../Packages/npm/bi-modules-0.0.5.tgz",
    "moment": "2.30.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "@angular/animations": "$@angular/animations",
    "@angular/common": "$@angular/common",
    "@angular/core": "$@angular/core",
    "@angular/material-moment-adapter": "$@angular/material-moment-adapter",
    "@salesbuzz/public-sdk": {
      "bi-interfaces": "$bi-interfaces",
      "bi-modules": "$bi-modules"
    }
  },
  "devDependencies": {
    "@angular/build": "20.2.2",
    "@angular/cli": "20.2.2",
    "@angular/compiler-cli": "20.2.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
